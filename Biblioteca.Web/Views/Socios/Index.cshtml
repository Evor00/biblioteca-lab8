@model IEnumerable<Socio>
@{
    ViewData["Title"] = "Socios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">👥 Socios</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo socio</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>DNI</th>
                <th>Nombre</th>
                <th>Correo electrónico</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="text-muted text-center py-4">No hay socios activos registrados.</td>
                </tr>
            }
            else
            {
                foreach (var socio in Model)
                {
                    <tr>
                        <td><code style="color:var(--bib-accent);background:rgba(6,182,212,.1);padding:.15rem .45rem;border-radius:4px;">@socio.DNI</code></td>
                        <td><strong>@socio.Nombre</strong></td>
                        <td>
                            <a href="mailto:@socio.Email" style="color:var(--bib-muted);text-decoration:none;">@socio.Email</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@model Libro
@{
    ViewData["Title"] = "Detalle del libro";
}

<h1 class="h3 mb-4">Detalle del libro</h1>

<dl class="row col-lg-8">
    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>
    <dt class="col-sm-3">Autor</dt>
    <dd class="col-sm-9">@Model.NombreAutor</dd>
    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@Model.ISBN</dd>
    <dt class="col-sm-3">Ejemplares</dt>
    <dd class="col-sm-9">@Model.Ejemplares</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@(Model.Activo ? "Activo" : "De baja")</dd>
</dl>

<div class="d-flex gap-2">
    @if (Model.Activo)
    {
        <a asp-action="Edit" asp-route-id="@Model.LibroId" class="btn btn-primary">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.LibroId" class="btn btn-outline-danger">Dar de baja</a>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>
